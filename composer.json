{
    "name": "parallelogram/craft-images",
    "description": "Responsive image variants for Craft CMS: named size sets, pre-generated AVIF and JPEG files, and <picture> markup for native or ParallelogramJS lazy loading.",
    "type": "craft-plugin",
    "license": "proprietary",
    "keywords": [
        "craftcms",
        "images",
        "responsive",
        "avif",
        "srcset"
    ],
    "authors": [
        {
            "name": "Parallelogram",
            "homepage": "https://parallelogram.com.au"
        }
    ],
    "support": {
        "email": "support@parallelogram.com.au",
        "issues": "https://github.com/parallelogram-dev/parallelogram-craft-images/issues",
        "source": "https://github.com/parallelogram-dev/parallelogram-craft-images",
        "docs": "https://github.com/parallelogram-dev/parallelogram-craft-images#readme"
    },
    "require": {
        "php": "^8.3",
        "craftcms/cms": "^5.6",
        "parallelogram/craft-kit": "^0.2 || *@dev"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "jcupitt/vips": "^2.4",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "parallelogram\\images\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "parallelogram\\images\\test\\": "test/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../parallelogram-craft-kit",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "handle": "p-images",
        "name": "Parallelogram Images",
        "developer": "Parallelogram",
        "developerUrl": "https://parallelogram.com.au",
        "documentationUrl": "https://github.com/parallelogram-dev/parallelogram-craft-images#readme",
        "class": "parallelogram\\images\\Plugin"
    },
    "scripts": {
        "lint": "mago lint",
        "analyze": "mago analyze",
        "fmt": "mago fmt",
        "fmt-check": "mago fmt --check",
        "test": "phpunit",
        "check": [
            "@fmt-check",
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "carthage-software/mago": true,
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "jcupitt/vips": "Fastest local generation through libvips (8.7 or later): ^2.4 with PHP's FFI extension, or ^1.0 with the vips PECL extension.",
        "ext-imagick": "Local generation with ImageMagick.",
        "ext-gd": "Local generation with GD where ImageMagick is unavailable."
    }
}
