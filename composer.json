{
  "name": "parallelogram-dev/parallelogram-image-variants",
  "description": "Parallelogram Image Variants — define, generate, and serve responsive image variants as pre-warmed static paths.",
  "version": "0.1.0",
  "type": "craft-plugin",
  "license": "proprietary",
  "require": {
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
    "psr-4": {
      "parallelogram\\imagevariants\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "parallelogram\\imagevariants\\test\\": "tests/"
    }
  },
  "scripts": {
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "static-analysis": "phpstan analyse",
    "test": "phpunit"
  },
  "extra": {
    "handle": "image-variants",
    "name": "Parallelogram Image Variants",
    "developer": "Parallelogram",
    "class": "parallelogram\\imagevariants\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "laminas/laminas-coding-standard": "^3.0"
  }
}
