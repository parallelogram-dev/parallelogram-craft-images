{% import "_includes/forms" as forms %}

{{ forms.editableTableField({
    label: 'Variant matrices'|t('image-variants'),
    instructions: 'Each row is a named matrix. Tick the formats to generate; widths are comma-separated pixel values. Per-variant heights and modes (the richer model) remain editable via config/image-variants.php.'|t('image-variants'),
    id: 'matrixRows',
    name: 'matrixRows',
    cols: {
        handle: { type: 'singleline', heading: 'Handle'|t('image-variants'), width: '12%', placeholder: 'card' },
        sizes: { type: 'singleline', heading: 'Sizes'|t('image-variants'), placeholder: '100vw' },
        widths: { type: 'singleline', heading: 'Widths'|t('image-variants'), placeholder: '480, 960, 1280' },
        avif: { type: 'checkbox', heading: 'AVIF'|t('image-variants') },
        webp: { type: 'checkbox', heading: 'WebP'|t('image-variants') },
        jpg: { type: 'checkbox', heading: 'JPG'|t('image-variants') },
        png: { type: 'checkbox', heading: 'PNG'|t('image-variants') },
        mode: { type: 'select', heading: 'Mode'|t('image-variants'), width: '12%', options: [
            { label: 'Crop', value: 'crop' },
            { label: 'Fit', value: 'fit' },
            { label: 'Stretch', value: 'stretch' },
            { label: 'Letterbox', value: 'letterbox' }
        ] }
    },
    rows: settings.matrixRowsForDisplay,
    addRowLabel: 'Add a matrix'|t('image-variants'),
    allowAdd: true,
    allowDelete: true,
    errors: settings.getErrors('matrices')
}) }}

<hr>

<h2>{{ 'Format quality'|t('image-variants') }}</h2>
<p class="instructions">{{ 'Encoder quality per format (1–100), applied to every matrix. The same number means different things per format — AVIF and WebP reach comparable quality at far lower values than JPG.'|t('image-variants') }}</p>

<div class="flex">
    {% for format, quality in settings.formatQuality %}
        {{ forms.textField({
            label: format | upper,
            id: 'formatQuality-' ~ format,
            name: 'formatQuality[' ~ format ~ ']',
            value: quality,
            type: 'number',
            min: 1,
            max: 100,
            size: 4
        }) }}
    {% endfor %}
</div>
{% if settings.getErrors('formatQuality') %}
    <ul class="errors">
        {% for error in settings.getErrors('formatQuality') %}<li>{{ error }}</li>{% endfor %}
    </ul>
{% endif %}

<hr>

<h2>{{ 'Field assignments'|t('image-variants') }}</h2>
<p class="instructions">{{ 'Tick which matrices each Asset field may render with. A field can allow several — the template picks one by key, and a render call using a key not ticked here will throw.'|t('image-variants') }}</p>

{% set matrixOptions = [] %}
{% for handle in matrixHandles %}
    {% set matrixOptions = matrixOptions | merge([{ label: handle, value: handle }]) %}
{% endfor %}

<input type="hidden" name="fieldAssignmentInput[__submitted]" value="1">

{% for field in assetFields %}
    {{ forms.checkboxSelectField({
        label: field.name ~ ' — ' ~ field.handle,
        id: 'assign-' ~ field.handle,
        name: 'fieldAssignmentInput[' ~ field.handle ~ ']',
        options: matrixOptions,
        values: settings.fieldAssignments[field.handle] ?? []
    }) }}
{% else %}
    <p class="light">{{ 'No Asset fields found.'|t('image-variants') }}</p>
{% endfor %}

{% if settings.getErrors('fieldAssignments') %}
    <ul class="errors">
        {% for error in settings.getErrors('fieldAssignments') %}<li>{{ error }}</li>{% endfor %}
    </ul>
{% endif %}
