{% import "_includes/forms" as forms %}

<div class="btngroup pi-tabs">
    <button type="button" class="btn pi-tab sel" data-pane="sizeSets">{{ 'Size sets'|t('p-images') }}</button>
    <button type="button" class="btn pi-tab" data-pane="assignments">{{ 'Pre-generate'|t('p-images') }}</button>
    <button type="button" class="btn pi-tab" data-pane="other">{{ 'Formats and processing'|t('p-images') }}</button>
</div>

<div class="pi-pane" data-pane="sizeSets">
    {{ forms.editableTableField({
        label: 'Size sets'|t('p-images'),
        instructions: 'Each row is a set of sizes a template can ask for, e.g. `asset.picture(\'card\')`. Widths are a comma-separated ladder (`480, 720, 960`); widths larger than an image are skipped, so nothing is upscaled. Give a ratio such as `4:3` to crop every width to the same shape, or leave it blank to keep each image’s proportions. Leave every format unticked to use the defaults.'|t('p-images'),
        id: 'sizeSetRows',
        name: 'sizeSetRows',
        cols: {
            handle: { type: 'singleline', heading: 'Handle'|t('p-images'), width: '12%', placeholder: 'card' },
            ratio: { type: 'singleline', heading: 'Ratio'|t('p-images'), width: '8%', placeholder: '4:3' },
            widths: { type: 'singleline', heading: 'Widths'|t('p-images'), placeholder: '480, 720, 960' },
            sizes: { type: 'singleline', heading: 'Sizes'|t('p-images'), placeholder: '100vw' },
            mode: { type: 'select', heading: 'Mode'|t('p-images'), width: '10%', options: [
                { label: 'Crop'|t('p-images'), value: 'crop' },
                { label: 'Fit'|t('p-images'), value: 'fit' },
                { label: 'Letterbox'|t('p-images'), value: 'letterbox' },
                { label: 'Stretch'|t('p-images'), value: 'stretch' }
            ] },
            avif: { type: 'checkbox', heading: 'AVIF' },
            webp: { type: 'checkbox', heading: 'WebP' },
            jpg: { type: 'checkbox', heading: 'JPG' },
            png: { type: 'checkbox', heading: 'PNG' }
        },
        rows: view.sizeSetRows(),
        addRowLabel: 'Add a size set'|t('p-images'),
        allowAdd: true,
        allowDelete: true,
        errors: settings.getErrors('sizeSets')
    }) }}
</div>

<div class="pi-pane hidden" data-pane="assignments">
    <p class="instructions">{{ 'Choose which size sets to generate ahead of time when an image is added to each field. Templates can use any size set; anything not generated ahead of time is made the first time it is requested.'|t('p-images') }}</p>

    {% set handles = view.sizeSetHandles() %}
    <input type="hidden" name="fieldAssignmentInput[__submitted]" value="1">

    {% for field in assetFields %}
        {{ forms.checkboxSelectField({
            label: field.name,
            instructions: field.handle,
            id: 'assign-' ~ field.uid,
            name: 'fieldAssignmentInput[' ~ field.uid ~ ']',
            options: handles | map(handle => { label: handle, value: handle }),
            values: view.handlesAssignedTo(field.uid)
        }) }}
    {% else %}
        <p class="light">{{ 'There are no Assets fields yet.'|t('p-images') }}</p>
    {% endfor %}

    {% if settings.getErrors('fieldAssignments') %}
        <ul class="errors">
            {% for error in settings.getErrors('fieldAssignments') %}<li>{{ error }}</li>{% endfor %}
        </ul>
    {% endif %}
</div>

<div class="pi-pane hidden" data-pane="other">
    {{ forms.checkboxSelectField({
        label: 'Default formats'|t('p-images'),
        instructions: 'Formats for size sets that don’t tick their own. The first universally supported one (JPG or PNG) is used for the `<img>` fallback.'|t('p-images'),
        id: 'defaultFormats',
        name: 'defaultFormats',
        options: formats | map(format => { label: format.name, value: format.value }),
        values: settings.defaultFormats,
        errors: settings.getErrors('defaultFormats')
    }) }}

    <h2>{{ 'Quality'|t('p-images') }}</h2>
    <p class="instructions">{{ 'Encoder quality per format (1–100) for the whole site. Leave blank for the default shown. AVIF and WebP reach similar quality at lower numbers than JPG.'|t('p-images') }}</p>

    <div class="flex">
        {% for format in formats %}
            {{ forms.textField({
                label: format.name,
                id: 'formatQuality-' ~ format.value,
                name: 'formatQuality[' ~ format.value ~ ']',
                value: settings.formatQuality[format.value] ?? '',
                placeholder: format.defaultQuality(),
                type: 'number',
                min: 1,
                max: 100,
                size: 4
            }) }}
        {% endfor %}
    </div>
    {% if settings.getErrors('formatQuality') %}
        <ul class="errors">
            {% for error in settings.getErrors('formatQuality') %}<li>{{ error }}</li>{% endfor %}
        </ul>
    {% endif %}

    <hr>

    <h2>{{ 'Processing'|t('p-images') }}</h2>

    {{ forms.lightswitchField({
        label: 'Auto-orient'|t('p-images'),
        instructions: 'Rotate images according to their EXIF orientation, so phone photos aren’t sideways.'|t('p-images'),
        id: 'autoOrient',
        name: 'autoOrient',
        on: settings.autoOrient
    }) }}

    {{ forms.lightswitchField({
        label: 'Convert to sRGB'|t('p-images'),
        instructions: 'Convert each image to the sRGB colour profile before resizing, so wide-gamut originals look as expected on the web.'|t('p-images'),
        id: 'convertToSrgb',
        name: 'convertToSrgb',
        on: settings.convertToSrgb
    }) }}

    {{ forms.textField({
        label: 'Sharpen amount'|t('p-images'),
        instructions: 'Sharpening applied after resizing (0 turns it off). Around 0.5 recovers the softness downscaling causes without halos.'|t('p-images'),
        id: 'sharpenAmount',
        name: 'sharpenAmount',
        value: settings.sharpenAmount,
        type: 'number',
        min: 0,
        max: 5,
        step: 0.1,
        size: 4,
        errors: settings.getErrors('sharpenAmount')
    }) }}

    {{ forms.textField({
        label: 'ImageMagick thread limit'|t('p-images'),
        instructions: 'Threads each encode may use. 0 leaves ImageMagick’s default. More threads speed up AVIF on multi-core servers; keep it a few below your core count.'|t('p-images'),
        id: 'threadLimit',
        name: 'threadLimit',
        value: settings.threadLimit,
        type: 'number',
        min: 0,
        max: 64,
        size: 4,
        errors: settings.getErrors('threadLimit')
    }) }}
</div>

{% css %}
.pi-tabs { margin-bottom: 24px; }
{% endcss %}

{% js %}
(function () {
    var tabs = document.querySelectorAll('.pi-tab');
    var panes = document.querySelectorAll('.pi-pane');

    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            var target = tab.getAttribute('data-pane');
            tabs.forEach(function (t) { t.classList.toggle('sel', t === tab); });
            panes.forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-pane') !== target); });
        });
    });
})();
{% endjs %}
