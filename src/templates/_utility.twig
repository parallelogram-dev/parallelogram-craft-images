{% macro action(route, label, instructions) %}
    <form method="post" accept-charset="UTF-8" class="pi-utility-action">
        {{ csrfInput() }}
        {{ actionInput(route) }}
        <p class="instructions">{{ instructions }}</p>
        <button type="submit" class="btn submit">{{ label }}</button>
    </form>
{% endmacro %}

{% from _self import action %}

<p class="instructions">{{ 'Image variants are made the first time they’re asked for; nothing is made when an image is uploaded. These buttons queue making the size sets chosen on the Pre-generate tab for images already uploaded, or removing variants nothing can ask for; progress shows in the queue.'|t('p-images') }}</p>

{{ action(
    'p-images/utility/warm',
    'Make missing variants'|t('p-images'),
    'Makes every image’s missing variants. Variants that already exist are left alone.'|t('p-images')
) }}

<hr>

{{ action(
    'p-images/utility/sweep',
    'Remove unused variants'|t('p-images'),
    'Removes variants of deleted images, and files left behind by replaced images or changed size sets.'|t('p-images')
) }}

<hr>

<p class="light">{{ 'On a server, use php craft p-images/warm, audit, rebuild and gc for the same work, with progress in the terminal.'|t('p-images') }}</p>
